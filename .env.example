# Copy this file to .env and fill in your own values. Never commit the real .env file.

# Get a free key (no credit card required) at https://console.groq.com/keys
GROQ_API_KEY=your-free-groq-api-key-here

# Primary model to use.
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated fallback models, tried in order if the primary model errors
# with a "not found" / "decommissioned" style error.
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b

# Only change this if Groq changes their API base URL.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Groq's free tier enforces real per-minute and per-day request caps. This
# paces calls to stay under the per-minute limit so you don't trip 429s.
LLM_RPM_LIMIT=25

# Max retry attempts per call before giving up with a clear error.
LLM_MAX_RETRIES=5

# Local safety cap on total calls per day, kept a bit below Groq's own free-tier
# limit so a bug can't silently burn your whole day's allowance via retries.
LLM_DAILY_SAFETY_CAP=900

# Set to "true" to run the baseline with a canned fake response instead of
# calling Groq at all. Use this to prove the code runs before spending any
# real API quota, or to grade this without a Groq key at all.
DRY_RUN=false
